{
  "name": "harness-deck",
  "displayName": "Harness Deck",
  "description": "%extension.description%",
  "version": "0.2.3",
  "publisher": "izrio",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/izrio/dsh-vscode-copilot.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrusted%"
    }
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "harnessDeck",
          "title": "%container.title%",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "views": {
      "harnessDeck": [
        {
          "type": "webview",
          "id": "harnessDeck.chatView",
          "name": "%view.chat%"
        }
      ]
    },
    "commands": [
      {
        "command": "harnessDeck.openChat",
        "title": "%command.openChat%",
        "category": "Harness Deck"
      },
      {
        "command": "harnessDeck.newSession",
        "title": "%command.newSession%",
        "category": "Harness Deck"
      },
      {
        "command": "harnessDeck.interrupt",
        "title": "%command.interrupt%",
        "category": "Harness Deck"
      },
      {
        "command": "harnessDeck.selectModel",
        "title": "%command.selectModel%",
        "category": "Harness Deck"
      },
      {
        "command": "harnessDeck.openWebUI",
        "title": "%command.openWebUI%",
        "category": "Harness Deck"
      },
      {
        "command": "harnessDeck.restartRuntime",
        "title": "%command.restartRuntime%",
        "category": "Harness Deck"
      },
      {
        "command": "harnessDeck.showLogs",
        "title": "%command.showLogs%",
        "category": "Harness Deck"
      },
      {
        "command": "harnessDeck.explainSelection",
        "title": "%command.explainSelection%",
        "category": "Harness Deck"
      },
      {
        "command": "harnessDeck.fixSelection",
        "title": "%command.fixSelection%",
        "category": "Harness Deck"
      },
      {
        "command": "harnessDeck.testSelection",
        "title": "%command.testSelection%",
        "category": "Harness Deck"
      },
      {
        "command": "harnessDeck.addToChat",
        "title": "%command.addToChat%",
        "category": "Harness Deck"
      },
      {
        "command": "harnessDeck.configureApiKey",
        "title": "%command.configureApiKey%",
        "category": "Harness Deck"
      },
      {
        "command": "harnessDeck.renameSession",
        "title": "%command.renameSession%",
        "category": "Harness Deck"
      },
      {
        "command": "harnessDeck.selectFolder",
        "title": "%command.selectFolder%",
        "category": "Harness Deck"
      },
      {
        "command": "harnessDeck.selectBackend",
        "title": "%command.selectBackend%",
        "category": "Harness Deck"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "harnessDeck.dsh.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.runtime.path%"
        },
        "harnessDeck.dsh.profile": {
          "type": "string",
          "default": "web",
          "markdownDescription": "%config.runtime.profile%"
        },
        "harnessDeck.backends": {
          "type": "array",
          "markdownDescription": "%config.backends%",
          "default": [
            {
              "id": "oh-my-pi",
              "name": "oh-my-pi",
              "command": "omp",
              "args": [
                "acp"
              ],
              "installHint": "%config.backends.ompHint%"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "properties": {
              "id": {
                "type": "string",
                "markdownDescription": "%config.backends.id%"
              },
              "name": {
                "type": "string",
                "markdownDescription": "%config.backends.name%"
              },
              "command": {
                "type": "string",
                "markdownDescription": "%config.backends.command%"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "markdownDescription": "%config.backends.args%"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "markdownDescription": "%config.backends.env%"
              },
              "installHint": {
                "type": "string",
                "markdownDescription": "%config.backends.installHint%"
              }
            }
          }
        },
        "harnessDeck.context.includeActiveEditor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.context.includeActiveEditor%"
        },
        "harnessDeck.ui.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh",
            "en"
          ],
          "default": "auto",
          "markdownDescription": "%config.ui.language%",
          "markdownEnumDescriptions": [
            "%config.ui.language.auto%",
            "%config.ui.language.zh%",
            "%config.ui.language.en%"
          ]
        },
        "harnessDeck.ui.fontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 32,
          "markdownDescription": "%config.ui.fontSize%"
        },
        "harnessDeck.ui.fontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.ui.fontFamily%"
        },
        "harnessDeck.ui.codeFontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.ui.codeFontFamily%"
        },
        "harnessDeck.ui.showTurnChanges": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.ui.showTurnChanges%"
        }
      }
    },
    "submenus": [
      {
        "id": "harnessDeck.editorContext",
        "label": "%submenu.editor%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "harnessDeck.editorContext",
          "group": "1_harnessDeck@1",
          "when": "resourceScheme == file"
        }
      ],
      "harnessDeck.editorContext": [
        {
          "command": "harnessDeck.explainSelection",
          "group": "1_ask@1"
        },
        {
          "command": "harnessDeck.fixSelection",
          "group": "1_ask@2"
        },
        {
          "command": "harnessDeck.testSelection",
          "group": "1_ask@3"
        },
        {
          "command": "harnessDeck.addToChat",
          "group": "2_context@1"
        }
      ],
      "commandPalette": [
        {
          "command": "harnessDeck.explainSelection",
          "when": "editorIsOpen"
        },
        {
          "command": "harnessDeck.fixSelection",
          "when": "editorIsOpen"
        },
        {
          "command": "harnessDeck.testSelection",
          "when": "editorIsOpen"
        },
        {
          "command": "harnessDeck.addToChat",
          "when": "editorIsOpen"
        },
        {
          "command": "harnessDeck.selectFolder",
          "when": "workspaceFolderCount > 1"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "tsx scripts/m0-smoke.ts",
    "package": "vsce package --no-dependencies --skip-license",
    "e2e": "tsx scripts/ui-e2e.ts",
    "vscode-e2e": "tsx scripts/vscode-e2e.ts",
    "acp-e2e": "tsx scripts/acp-e2e.ts"
  },
  "dependencies": {
    "@dsh-copilot/shared": "workspace:*",
    "diff": "^8.0.4",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/vscode": "~1.106.0",
    "@types/ws": "^8.18.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0"
  }
}
