{
  "name": "dsh-copilot",
  "displayName": "DSH Copilot",
  "description": "DeepSeek Harness（dsh）的 VS Code 前端：Codex 风格的对话、审批与改动查看。",
  "version": "0.0.1",
  "publisher": "izrio",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/izrio/dsh-vscode-copilot.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "dsh 会在工作区中读写文件和执行命令，需要先信任工作区。"
    }
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "dsh",
          "title": "DSH",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "views": {
      "dsh": [
        {
          "type": "webview",
          "id": "dsh.chatView",
          "name": "对话"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh.openChat",
        "title": "打开对话",
        "category": "DSH"
      },
      {
        "command": "dsh.newSession",
        "title": "新建对话",
        "category": "DSH"
      },
      {
        "command": "dsh.interrupt",
        "title": "停止生成",
        "category": "DSH"
      },
      {
        "command": "dsh.selectModel",
        "title": "切换模型",
        "category": "DSH"
      },
      {
        "command": "dsh.openWebUI",
        "title": "在浏览器中打开 dsh",
        "category": "DSH"
      },
      {
        "command": "dsh.restartRuntime",
        "title": "重启 dsh",
        "category": "DSH"
      },
      {
        "command": "dsh.showLogs",
        "title": "查看日志",
        "category": "DSH"
      },
      {
        "command": "dsh.explainSelection",
        "title": "解释这段代码",
        "category": "DSH"
      },
      {
        "command": "dsh.fixSelection",
        "title": "修复这段代码",
        "category": "DSH"
      },
      {
        "command": "dsh.testSelection",
        "title": "为这段代码写测试",
        "category": "DSH"
      },
      {
        "command": "dsh.addToChat",
        "title": "添加到对话",
        "category": "DSH"
      }
    ],
    "configuration": {
      "title": "DSH",
      "properties": {
        "dsh.runtime.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "dsh 可执行文件的路径。留空时在 `PATH` 中查找（DeepSeek Desktop 安装的 `dsh` 命令，或 `npm install -g @deepseek-ai/dsh`）。"
        },
        "dsh.runtime.profile": {
          "type": "string",
          "default": "web",
          "markdownDescription": "启动 dsh 时使用的 profile。默认 `web`，与你自己运行的 `dsh web` 共用模型、API Key 和权限预设。"
        },
        "dsh.context.includeActiveEditor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "发送消息时默认附带当前编辑器：有选区时附带选中的代码和行号，否则只附带文件路径（dsh 需要时自己读取）。可以在输入框上方的标签上逐条关闭。"
        }
      }
    },
    "submenus": [
      {
        "id": "dsh.editorContext",
        "label": "DSH"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "dsh.editorContext",
          "group": "1_dsh@1",
          "when": "resourceScheme == file"
        }
      ],
      "dsh.editorContext": [
        {
          "command": "dsh.explainSelection",
          "group": "1_ask@1"
        },
        {
          "command": "dsh.fixSelection",
          "group": "1_ask@2"
        },
        {
          "command": "dsh.testSelection",
          "group": "1_ask@3"
        },
        {
          "command": "dsh.addToChat",
          "group": "2_context@1"
        }
      ],
      "commandPalette": [
        {
          "command": "dsh.explainSelection",
          "when": "editorIsOpen"
        },
        {
          "command": "dsh.fixSelection",
          "when": "editorIsOpen"
        },
        {
          "command": "dsh.testSelection",
          "when": "editorIsOpen"
        },
        {
          "command": "dsh.addToChat",
          "when": "editorIsOpen"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "tsx scripts/m0-smoke.ts",
    "package": "vsce package --no-dependencies --skip-license",
    "e2e": "tsx scripts/ui-e2e.ts",
    "vscode-e2e": "tsx scripts/vscode-e2e.ts"
  },
  "dependencies": {
    "@dsh-copilot/shared": "workspace:*",
    "diff": "^8.0.4",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/vscode": "~1.106.0",
    "@types/ws": "^8.18.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0"
  }
}
