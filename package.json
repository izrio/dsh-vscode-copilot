{
  "name": "dsh-vscode-copilot-workspace",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter @dsh-copilot/webview-ui run build && pnpm --filter dsh-copilot run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "smoke": "pnpm --filter dsh-copilot run smoke",
    "package": "pnpm run build && pnpm --filter dsh-copilot run package",
    "dev": "pnpm --parallel --filter @dsh-copilot/webview-ui --filter dsh-copilot run watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
