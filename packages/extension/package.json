{
  "name": "dsh-copilot",
  "displayName": "DSH Copilot",
  "description": "%extension.description%",
  "version": "0.0.1",
  "publisher": "izrio",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/izrio/dsh-vscode-copilot.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "dsh 会在工作区中读写文件和执行命令，需要先信任工作区。"
    }
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "dsh",
          "title": "%container.title%",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "views": {
      "dsh": [
        {
          "type": "webview",
          "id": "dsh.chatView",
          "name": "%view.chat%"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh.openChat",
        "title": "%command.openChat%",
        "category": "DSH"
      },
      {
        "command": "dsh.newSession",
        "title": "%command.newSession%",
        "category": "DSH"
      },
      {
        "command": "dsh.interrupt",
        "title": "%command.interrupt%",
        "category": "DSH"
      },
      {
        "command": "dsh.selectModel",
        "title": "%command.selectModel%",
        "category": "DSH"
      },
      {
        "command": "dsh.openWebUI",
        "title": "%command.openWebUI%",
        "category": "DSH"
      },
      {
        "command": "dsh.restartRuntime",
        "title": "%command.restartRuntime%",
        "category": "DSH"
      },
      {
        "command": "dsh.showLogs",
        "title": "%command.showLogs%",
        "category": "DSH"
      },
      {
        "command": "dsh.explainSelection",
        "title": "%command.explainSelection%",
        "category": "DSH"
      },
      {
        "command": "dsh.fixSelection",
        "title": "%command.fixSelection%",
        "category": "DSH"
      },
      {
        "command": "dsh.testSelection",
        "title": "%command.testSelection%",
        "category": "DSH"
      },
      {
        "command": "dsh.addToChat",
        "title": "%command.addToChat%",
        "category": "DSH"
      },
      {
        "command": "dsh.configureApiKey",
        "title": "%command.configureApiKey%",
        "category": "DSH"
      },
      {
        "command": "dsh.renameSession",
        "title": "%command.renameSession%",
        "category": "DSH"
      },
      {
        "command": "dsh.selectFolder",
        "title": "%command.selectFolder%",
        "category": "DSH"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "dsh.runtime.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.runtime.path%"
        },
        "dsh.runtime.profile": {
          "type": "string",
          "default": "web",
          "markdownDescription": "%config.runtime.profile%"
        },
        "dsh.context.includeActiveEditor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.context.includeActiveEditor%"
        },
        "dsh.ui.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh",
            "en"
          ],
          "default": "auto",
          "markdownDescription": "%config.ui.language%",
          "markdownEnumDescriptions": [
            "%config.ui.language.auto%",
            "%config.ui.language.zh%",
            "%config.ui.language.en%"
          ]
        }
      }
    },
    "submenus": [
      {
        "id": "dsh.editorContext",
        "label": "%submenu.editor%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "dsh.editorContext",
          "group": "1_dsh@1",
          "when": "resourceScheme == file"
        }
      ],
      "dsh.editorContext": [
        {
          "command": "dsh.explainSelection",
          "group": "1_ask@1"
        },
        {
          "command": "dsh.fixSelection",
          "group": "1_ask@2"
        },
        {
          "command": "dsh.testSelection",
          "group": "1_ask@3"
        },
        {
          "command": "dsh.addToChat",
          "group": "2_context@1"
        }
      ],
      "commandPalette": [
        {
          "command": "dsh.explainSelection",
          "when": "editorIsOpen"
        },
        {
          "command": "dsh.fixSelection",
          "when": "editorIsOpen"
        },
        {
          "command": "dsh.testSelection",
          "when": "editorIsOpen"
        },
        {
          "command": "dsh.addToChat",
          "when": "editorIsOpen"
        },
        {
          "command": "dsh.selectFolder",
          "when": "workspaceFolderCount > 1"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "tsx scripts/m0-smoke.ts",
    "package": "vsce package --no-dependencies --skip-license",
    "e2e": "tsx scripts/ui-e2e.ts",
    "vscode-e2e": "tsx scripts/vscode-e2e.ts"
  },
  "dependencies": {
    "@dsh-copilot/shared": "workspace:*",
    "diff": "^8.0.4",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/vscode": "~1.106.0",
    "@types/ws": "^8.18.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0"
  }
}
